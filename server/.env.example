# Copy to .env for local development (never commit .env).
# In Docker / Cloud Run, inject these at runtime — do not bake into the image.

TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=          # required for Turso cloud (libsql://…); omit for file:local.db
JWT_SECRET=change-me-in-production
PORT=3001
